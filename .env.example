# Repcut environment configuration
#
# ┌──────────────────────────────────────────────────────────────────────┐
# │  THIS FILE IS COMMITTED. IT MUST NEVER CONTAIN A REAL VALUE.         │
# │  Key NAMES only, values EMPTY. Copy to .env and fill that in.        │
# │  .env is gitignored and must stay that way.                          │
# └──────────────────────────────────────────────────────────────────────┘

# --- Secrets (fill in .env, never here) ---
GEMINI_API_KEY=

# --- Paths (machine-local, no usernames committed) ---
# DATA_DIR must sit OUTSIDE any cloud-sync folder (OneDrive, Dropbox, Google
# Drive). Sync placeholders break ffprobe, the sync agent locks in-flight
# uploads, and footage would be copied off the machine. Use an absolute path
# when the repo itself lives inside a synced folder. The engine warns at
# startup and `make check-env` flags it.
DATA_DIR=./data
REPCUT_GUIDE_PATH=
# Empty = derived from DATA_DIR ($DATA_DIR/repcut.db). Override only to point at
# a scratch database. Never a URL containing credentials.
DATABASE_URL=

# --- Services ---
# ENGINE_HOST is the interface uvicorn binds. Leave it on loopback. The engine
# has NO authentication - it is one person's laptop - so binding it to 0.0.0.0
# publishes every clip on the machine to the local network. `make dev` reads
# this, and the engine logs a warning if it is not loopback.
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8000
UI_PORT=3000
ENGINE_URL=http://localhost:8000

# --- Network boundary ---
# Both empty by default and almost always correct that way: every loopback name
# is allowed already. Set these ONLY for a deliberate case - reaching the engine
# from a phone on the same wifi to check a portrait export - and unset them
# after. Comma-separated.
#   EXTRA_ALLOWED_HOSTS   bare hostnames, e.g. 192.168.1.40
#   EXTRA_ALLOWED_ORIGINS full origins,    e.g. http://192.168.1.40:3000
EXTRA_ALLOWED_HOSTS=
EXTRA_ALLOWED_ORIGINS=

# --- Runtime ---
LOG_LEVEL=INFO
GEMINI_RPM_LIMIT=10
GEMINI_DAILY_LIMIT=1400
TORCH_DEVICE=auto
