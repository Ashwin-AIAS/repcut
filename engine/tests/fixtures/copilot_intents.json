{
  "about": "Copilot intent eval. Each intent: the request, what a correct turn does (expect), and a scripted model answer for the replay run (script, one list of calls per model step). {cut:N}, {clip:N}, {hero:N}, {word:N}, {track:N}, {hook:other} resolve against the edit when the intent runs.",
  "intents": [
    {"id": "i01", "kind": "single", "text": "go moodier on the colours",
     "expect": {"outcome": "done", "operations": [{"name": "set_theme", "args": {"theme_id": "moody"}}]},
     "script": [[{"name": "set_theme", "args": {"theme_id": "moody"}}]]},
    {"id": "i02", "kind": "single", "text": "make it about 15 seconds long",
     "expect": {"outcome": "done", "operations": [{"name": "set_target_duration", "args": {"seconds": 15}}]},
     "script": [[{"name": "set_target_duration", "args": {"seconds": 15}}]]},
    {"id": "i03", "kind": "single", "text": "start the video on the other big moment",
     "expect": {"outcome": "done", "operations": [{"name": "choose_hook", "args": {"segment_id": "{hook:other}"}}]},
     "script": [[{"name": "choose_hook", "args": {"segment_id": "{hook:other}"}}]]},
    {"id": "i04", "kind": "single", "text": "use the 128 bpm track from my library",
     "expect": {"outcome": "done", "operations": [{"name": "set_music_track", "args": {"track": "{track:1}"}}]},
     "script": [[{"name": "set_music_track", "args": {"track": "{track:1}"}}]]},
    {"id": "i05", "kind": "single", "text": "turn the grade strength down to 40",
     "expect": {"outcome": "done", "operations": [{"name": "set_intensity", "args": {"intensity": 40}}]},
     "script": [[{"name": "set_intensity", "args": {"intensity": 40}}]]},
    {"id": "i06", "kind": "single", "text": "take out the third cut",
     "expect": {"outcome": "done", "operations": [{"name": "remove_cut", "args": {"shot_id": "{cut:3}"}}]},
     "script": [[{"name": "remove_cut", "args": {"shot_id": "{cut:3}"}}]]},
    {"id": "i07", "kind": "single", "text": "slow motion on the first hero moment",
     "expect": {"outcome": "done", "operations": [{"name": "set_slowmo", "args": {"segment_id": "{hero:1}", "on": true}}]},
     "script": [[{"name": "set_slowmo", "args": {"segment_id": "{hero:1}", "on": true}}]]},
    {"id": "i08", "kind": "single", "text": "keep the first cut exactly where it is",
     "expect": {"outcome": "done", "operations": [{"name": "lock_cut", "args": {"shot_id": "{cut:1}"}}]},
     "script": [[{"name": "lock_cut", "args": {"shot_id": "{cut:1}", "locked": true}}]]},
    {"id": "i09", "kind": "single", "text": "classic captions please",
     "expect": {"outcome": "done", "operations": [{"name": "set_caption_style", "args": {"style_id": "classic"}}]},
     "script": [[{"name": "set_caption_style", "args": {"style_id": "classic"}}]]},
    {"id": "i10", "kind": "single", "text": "the first caption word should read 'los'",
     "expect": {"outcome": "done", "operations": [{"name": "edit_caption_text", "args": {"word_id": "{word:1}", "text": "los"}}]},
     "script": [[{"name": "edit_caption_text", "args": {"word_id": "{word:1}", "text": "los"}}]]},
    {"id": "i11", "kind": "single", "text": "export it square",
     "expect": {"outcome": "done", "operations": [{"name": "set_export_preset", "args": {"preset_id": "square"}}]},
     "script": [[{"name": "set_export_preset", "args": {"preset_id": "square"}}]]},
    {"id": "i12", "kind": "single", "text": "undo that",
     "expect": {"outcome": "done", "operations": [{"name": "undo_last", "args": {}}]},
     "script": [[{"name": "undo_last", "args": {}}]]},
    {"id": "i13", "kind": "multi", "text": "hard contrast look, and bring it down to 20 seconds",
     "expect": {"outcome": "done", "operations": [
       {"name": "set_theme", "args": {"theme_id": "hardstyle"}},
       {"name": "set_target_duration", "args": {"seconds": 20}}]},
     "script": [[{"name": "set_theme", "args": {"theme_id": "hardstyle"}},
                 {"name": "set_target_duration", "args": {"seconds": 20}}]]},
    {"id": "i14", "kind": "multi", "text": "hide the captions and switch to landscape",
     "expect": {"outcome": "done", "operations": [
       {"name": "set_caption_style", "args": {"enabled": false}},
       {"name": "set_export_preset", "args": {"preset_id": "landscape"}}]},
     "script": [[{"name": "set_caption_style", "args": {"enabled": false}}],
                [{"name": "set_export_preset", "args": {"preset_id": "landscape"}}]]},
    {"id": "i15", "kind": "multi", "text": "no opening moment, and lock the second cut",
     "expect": {"outcome": "done", "operations": [
       {"name": "toggle_hook", "args": {"on": false}},
       {"name": "lock_cut", "args": {"shot_id": "{cut:2}"}}]},
     "script": [[{"name": "toggle_hook", "args": {"on": false}},
                 {"name": "lock_cut", "args": {"shot_id": "{cut:2}"}}]]},
    {"id": "i16", "kind": "ambiguous", "text": "drop the second one",
     "expect": {"outcome": "asked"},
     "script": [[{"name": "ask_clarifying_question", "args": {"question": "The second cut (#2) or the second clip?"}}]]},
    {"id": "i17", "kind": "ambiguous", "text": "slow that bit down",
     "expect": {"outcome": "asked"},
     "script": [[{"name": "ask_clarifying_question", "args": {"question": "Which moment: hero moment 1 or 2?"}}]]},
    {"id": "i18", "kind": "principle", "text": "replace my background with a beach",
     "expect": {"outcome": "refused"}, "script": []},
    {"id": "i19", "kind": "principle", "text": "make my shoulders look wider",
     "expect": {"outcome": "refused"}, "script": []},
    {"id": "i20", "kind": "impossible", "text": "add a spinning wipe between the cuts",
     "expect": {"outcome": "unmet"},
     "script": [[{"name": "report_unsupported", "args": {"request": "a wipe transition between cuts"}}]]}
  ]
}
